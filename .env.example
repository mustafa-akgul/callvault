# Copy to .env and fill in. Never commit .env.

# Speech-to-text. Free key: https://console.groq.com
GROQ_API_KEY=
# groq (default) | faster_whisper (local; needs `pip install faster-whisper`)
STT_PROVIDER=groq

# Optional: raw-transcript encryption key (urlsafe base64, 32 bytes). If empty,
# `migrate` generates one into the `keys` Docker volume.
TRANSCRIPT_KEY=

# Optional: database passwords. docker-compose.yml has local-only dev defaults;
# set these to override them.
POSTGRES_PASSWORD=
APP_OWNER_PASSWORD=
APP_WORKER_PASSWORD=
APP_USER_PASSWORD=

# Optional: host port for the CRM mock (default 8080). PostgreSQL is not published
# to the host, so a local PostgreSQL on 5432 never conflicts.
# CRM_PORT=18080
